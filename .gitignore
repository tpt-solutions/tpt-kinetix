# Rust/Cargo
/target
**/*.rs.bk

# Cargo.lock: committed for binary crates / workspace, excluded for pure libraries.
# This workspace contains binaries, so Cargo.lock is tracked (not ignored).

# Fuzz testing (unanchored so this matches fuzz/ dirs nested under any crate,
# e.g. tpt-kinetix-h264/fuzz/ — a mid-path slash would otherwise anchor the
# pattern to the repo root and silently miss them)
**/fuzz/target/
**/fuzz/corpus/
**/fuzz/artifacts/
**/fuzz/coverage/

# wasm-pack build output (regenerate with `just wasm-demo`)
/web-demo/pkg/

# Large media samples — never commit binary media to the repo
*.mp4
*.mkv
*.mov
*.avi
*.ts
*.flv
*.yuv
*.h264
*.h265
*.av1

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Env / local config
.env
.env.local

# Scratch / work artifacts
scratch_*.txt
*.bak
*.ps1
# ffmpeg reference headers/extracted source dropped in during codec bring-up
ff_*.h
ff_*.c
# loose debug/extract dumps (bJ.txt, cbX.txt, r1.txt, buildlog.txt, ncs.txt, …)
*.txt
**/__pycache__/

# AV1 Phase G.0 block-capture bridge output (written by KINETIX_AV1_CAPTURE)
av1_capture.json
# AV1 Phase G.0 full-tile symbol-trace capture (written by KINETIX_AV1_CAPTURE_TILE)
av1_tile_trace.json

# Claude Code agent worktree scratch space (not repo content)
/.claude/
